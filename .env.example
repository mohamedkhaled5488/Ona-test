# Copy this to .env and fill in your Supabase project's values
# (Project Settings -> API in the Supabase dashboard).
#
# EXPO_PUBLIC_-prefixed vars are safe to expose in the client bundle — the
# anon key relies on row-level security (see supabase/migrations/0001_init.sql)
# to keep each user's data private, not on keeping the key itself secret.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Google sign-in (docs/google-signin-setup.md). The *Web* client ID from Google
# Cloud, not the Android one. Public by design; still kept out of git via .env.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
