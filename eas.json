{
  "cli": {
    "version": ">= 24.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "environment": "development",
      "env": {
        "ORG_GRADLE_PROJECT_reactNativeArchitectures": "arm64-v8a"
      }
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "environment": "preview",
      "env": {
        "ORG_GRADLE_PROJECT_reactNativeArchitectures": "arm64-v8a"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production"
    },
    "e2e-test": {
      "withoutCredentials": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_SUPABASE_URL": "http://127.0.0.1:9",
        "EXPO_PUBLIC_SUPABASE_ANON_KEY": "e2e-no-server",
        "ORG_GRADLE_PROJECT_reactNativeArchitectures": "x86_64,arm64-v8a"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {}
    }
  }
}
