[
  { "id": "where-i-am.light.01", "theme": "where-i-am", "depth": "light", "stage": "arrive", "text": "What's taking up most of the room in your head today?", "tags": ["today"], "reviewed": false, "sensitivity": "standard" },
  { "id": "where-i-am.light.02", "theme": "where-i-am", "depth": "light", "stage": "arrive", "text": "If today had a weather forecast, what would it say?", "tags": ["today", "playful"], "reviewed": false, "sensitivity": "standard" },
  { "id": "where-i-am.light.03", "theme": "where-i-am", "depth": "light", "stage": "arrive", "text": "What did your body notice first when you sat down just now?", "tags": ["body"], "reviewed": false, "sensitivity": "standard" },
  { "id": "where-i-am.light.04", "theme": "where-i-am", "depth": "light", "stage": "explore", "text": "What has been easier than you expected lately?", "tags": ["going-well"], "reviewed": false, "sensitivity": "standard" },
  { "id": "where-i-am.light.05", "theme": "where-i-am", "depth": "light", "stage": "explore", "text": "What's one thing you're looking forward to, even a small one?", "tags": ["ahead"], "reviewed": false, "sensitivity": "standard" },
  { "id": "where-i-am.light.06", "theme": "where-i-am", "depth": "light", "stage": "explore", "text": "Which part of your day felt most like you?", "tags": ["today", "self"], "reviewed": false, "sensitivity": "standard" },
  { "id": "where-i-am.light.07", "theme": "where-i-am", "depth": "light", "stage": "explore", "text": "What's something you've been carrying around that you could put down for a while?", "tags": ["load"], "reviewed": false, "sensitivity": "standard" },
  { "id": "where-i-am.light.08", "theme": "where-i-am", "depth": "light", "stage": "explore", "text": "Who have you been thinking about this week?", "tags": ["people"], "reviewed": false, "sensitivity": "standard" },
  { "id": "where-i-am.light.09", "theme": "where-i-am", "depth": "light", "stage": "explore", "text": "What has been quietly going well?", "tags": ["going-well"], "reviewed": false, "sensitivity": "standard" },
  { "id": "where-i-am.light.10", "theme": "where-i-am", "depth": "light", "stage": "deepen", "text": "If a friend described your week, what might they notice that you'd miss?", "tags": ["perspective"], "reviewed": false, "sensitivity": "standard" },
  { "id": "where-i-am.light.11", "theme": "where-i-am", "depth": "light", "stage": "close", "text": "What would make the rest of today a little kinder?", "tags": ["today", "care"], "reviewed": false, "sensitivity": "standard" },
  { "id": "where-i-am.light.12", "theme": "where-i-am", "depth": "light", "stage": "close", "text": "What's one word for where you are right now?", "tags": ["today"], "reviewed": false, "sensitivity": "standard" },

  { "id": "where-i-am.medium.01", "theme": "where-i-am", "depth": "medium", "stage": "arrive", "text": "Picture the last few weeks as a road. Which stretch are you on now: uphill, flat, a turning, a rest stop?", "tags": ["season", "playful"], "reviewed": false, "sensitivity": "standard" },
  { "id": "where-i-am.medium.02", "theme": "where-i-am", "depth": "medium", "stage": "arrive", "text": "What's been asking for your attention that you haven't given it yet?", "tags": ["load"], "reviewed": false, "sensitivity": "standard" },
  { "id": "where-i-am.medium.03", "theme": "where-i-am", "depth": "medium", "stage": "explore", "text": "What are you spending energy on that you don't really believe in?", "tags": ["energy"], "reviewed": false, "sensitivity": "standard" },
  { "id": "where-i-am.medium.04", "theme": "where-i-am", "depth": "medium", "stage": "explore", "text": "What have you said yes to lately that you'd like to have said no to?", "tags": ["boundaries"], "reviewed": false, "sensitivity": "standard" },
  { "id": "where-i-am.medium.05", "theme": "where-i-am", "depth": "medium", "stage": "explore", "text": "Where do you feel most stretched right now, and where do you have room?", "tags": ["load", "energy"], "reviewed": false, "sensitivity": "standard" },
  { "id": "where-i-am.medium.06", "theme": "where-i-am", "depth": "medium", "stage": "explore", "text": "What would you like more of this month? And less of?", "tags": ["ahead"], "reviewed": false, "sensitivity": "standard" },
  { "id": "where-i-am.medium.07", "theme": "where-i-am", "depth": "medium", "stage": "explore", "text": "What have you been putting off, and what does putting it off give you?", "tags": ["avoiding"], "reviewed": false, "sensitivity": "standard" },
  { "id": "where-i-am.medium.08", "theme": "where-i-am", "depth": "medium", "stage": "explore", "text": "Which of your recent days would you happily live again?", "tags": ["going-well"], "reviewed": false, "sensitivity": "standard" },
  { "id": "where-i-am.medium.09", "theme": "where-i-am", "depth": "medium", "stage": "explore", "text": "What has changed in you since the start of this year?", "tags": ["change"], "reviewed": false, "sensitivity": "standard" },
  { "id": "where-i-am.medium.10", "theme": "where-i-am", "depth": "medium", "stage": "deepen", "text": "What are you hoping will change without you having to choose it?", "tags": ["change", "choice"], "reviewed": false, "sensitivity": "standard" },
  { "id": "where-i-am.medium.11", "theme": "where-i-am", "depth": "medium", "stage": "deepen", "text": "If nothing changed for a year, how would you feel about that?", "tags": ["change"], "reviewed": false, "sensitivity": "standard" },
  { "id": "where-i-am.medium.12", "theme": "where-i-am", "depth": "medium", "stage": "close", "text": "What's one honest sentence about where you are, without trying to fix anything?", "tags": ["today"], "reviewed": false, "sensitivity": "standard" },

  { "id": "where-i-am.deep.01", "theme": "where-i-am", "depth": "deep", "stage": "arrive", "text": "What's the thing about your life right now that you tend not to say out loud?", "tags": ["unsaid"], "reviewed": false, "sensitivity": "standard" },
  { "id": "where-i-am.deep.02", "theme": "where-i-am", "depth": "deep", "stage": "arrive", "text": "When it's quiet and you're on your own, which thought tends to come back?", "tags": ["unsaid"], "reviewed": false, "sensitivity": "standard" },
  { "id": "where-i-am.deep.03", "theme": "where-i-am", "depth": "deep", "stage": "explore", "text": "Is there something you're grieving at the moment, even something small, or something that never happened?", "tags": ["loss"], "reviewed": false, "sensitivity": "heavy" },
  { "id": "where-i-am.deep.04", "theme": "where-i-am", "depth": "deep", "stage": "explore", "text": "Where in your life are you waiting for permission? Whose permission?", "tags": ["choice"], "reviewed": false, "sensitivity": "standard" },
  { "id": "where-i-am.deep.05", "theme": "where-i-am", "depth": "deep", "stage": "explore", "text": "What would you do differently if you weren't worried about disappointing anyone?", "tags": ["choice", "people"], "reviewed": false, "sensitivity": "standard" },
  { "id": "where-i-am.deep.06", "theme": "where-i-am", "depth": "deep", "stage": "explore", "text": "Which part of you have you been ignoring lately, and what does it want?", "tags": ["self"], "reviewed": false, "sensitivity": "standard" },
  { "id": "where-i-am.deep.07", "theme": "where-i-am", "depth": "deep", "stage": "explore", "text": "What do you already know about your situation that you haven't acted on yet?", "tags": ["unsaid", "choice"], "reviewed": false, "sensitivity": "standard" },
  { "id": "where-i-am.deep.08", "theme": "where-i-am", "depth": "deep", "stage": "explore", "text": "What are you holding together right now that's costing you more than it looks?", "tags": ["load"], "reviewed": false, "sensitivity": "standard" },
  { "id": "where-i-am.deep.09", "theme": "where-i-am", "depth": "deep", "stage": "deepen", "text": "Imagine yourself a few years from now, looking back at this time. What do you think they'd want you to know?", "tags": ["perspective"], "reviewed": false, "sensitivity": "standard" },
  { "id": "where-i-am.deep.10", "theme": "where-i-am", "depth": "deep", "stage": "deepen", "text": "What do you need right now that you're finding hard to ask for?", "tags": ["care", "people"], "reviewed": false, "sensitivity": "standard" },
  { "id": "where-i-am.deep.11", "theme": "where-i-am", "depth": "deep", "stage": "deepen", "text": "What would \"enough\" look like for you at the moment?", "tags": ["load", "care"], "reviewed": false, "sensitivity": "standard" },
  { "id": "where-i-am.deep.12", "theme": "where-i-am", "depth": "deep", "stage": "close", "text": "What do you want to remember about this moment, whatever happens next?", "tags": ["today"], "reviewed": false, "sensitivity": "standard" }
]
